# Copy to .env and fill in. Both are optional — the site runs without them,
# it just falls back to the bundled estimates and hides live results.

# ── YouTube Data API v3 ──────────────────────────────────────────────
# This is what produces the live view counts. Free, 10,000 quota units/day.
# console.cloud.google.com → new project → enable "YouTube Data API v3"
#   → Credentials → Create credentials → API key
YOUTUBE_API_KEY=

# ── Meta Ad Library API ──────────────────────────────────────────────
# Powers the "what a brand is running right now" section. Free, but you must
# confirm your identity and location with Meta first.
#   1. facebook.com/ID  → complete ID confirmation (can take a day or two)
#   2. developers.facebook.com → create an app (type: Business)
#   3. Graph API Explorer → generate a User token with `ads_read`
#   4. Extend it to a 60-day token at developers.facebook.com/tools/debug/accesstoken
META_ACCESS_TOKEN=
META_API_VERSION=v23.0

# Markets queried when the UI does not name one. ad_type=ALL returns commercial
# ads only in the EU/UK; elsewhere the archive holds political and issue ads only.
META_COUNTRIES=IE,DE,FR,ES,IT,NL,SE,PL

# ── server ───────────────────────────────────────────────────────────
PORT=8123
LIBRARY_TTL_MINUTES=15
META_TTL_MINUTES=60
